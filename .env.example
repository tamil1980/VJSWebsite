# =========================================================
# VJS Soft Solutions - Enquiry Form Email Configuration
# =========================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file or share these credentials.
#
# Gmail example (use an App Password, NOT your normal password):
#   https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=youraccount@gmail.com
#   SMTP_PASS=your-16-char-app-password

# Who the email is sent FROM (the mailbox you authenticate with)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vjssoftsystems@gmail.com
SMTP_PASS=tamilselvan0206

# Where enquiry emails are delivered to
CONTACT_EMAIL=vjssoftsystems@gmail.com

# Comma separated list of allowed origins (CORS). "*" allows any origin.
ALLOWED_ORIGINS=*

# Port the web app listens on
PORT=3000